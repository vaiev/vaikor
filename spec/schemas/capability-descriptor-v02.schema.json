{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaikor.com/spec/schemas/capability-descriptor-v02.schema.json",
  "title": "Vaikor capability descriptor (v0.2)",
  "description": "Protocol-neutral description of one capability (VKR-L1). It declares arguments, result shape, effects, data classes, residency, cost, and whether a call is consequential. It is not a grant. Status: Draft v0.2. Adds integrity, roles, quarantine, idempotent, timeout_s and model to v0.1 (docs/specs/0003-plan.md section 7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "title",
    "input_schema",
    "effects",
    "data_classes",
    "consequential"
  ],
  "properties": {
    "v": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "pattern": "^tag:vaikor\\.com,2026:capability:[A-Za-z0-9._-]{1,128}$",
      "description": "Capability identifier (VKR-L1 R1)."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "input_schema": {
      "type": "object",
      "description": "JSON Schema 2020-12 for arguments. type, when present, is object (VKR-L1 R4)."
    },
    "output_schema": {
      "type": "object",
      "description": "JSON Schema 2020-12 for a successful result (VKR-L1 R5)."
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "compute",
          "read",
          "write",
          "delete",
          "execute",
          "egress"
        ]
      },
      "description": "Effect codes from registries/effects.md (VKR-L1 R6)."
    },
    "data_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/dataClass"
      },
      "description": "Data classes touched by the capability. Empty when no personal data is involved (VKR-L1 R7, R10)."
    },
    "residency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tags"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/residencyTag"
          }
        }
      },
      "description": "Residency tags (VKR-L1 R8 v0.2). Missing or empty tags fail closed at egress; a publisher that sets no limit uses the single tag unrestricted. Required with at least one tag when effects include egress."
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "free",
            "metered"
          ]
        },
        "max": {
          "$ref": "common.schema.json#/$defs/money"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "metered"
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "required": [
              "max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "free"
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "not": {
              "required": [
                "max"
              ]
            }
          }
        }
      ],
      "description": "Upper bound on cost (VKR-L1 R11)."
    },
    "consequential": {
      "type": "boolean",
      "description": "True when a call needs Trusted UI approval. Required true for delete, execute, and egress (VKR-L1 R9)."
    },
    "integrity": {
      "enum": [
        "trusted",
        "untrusted"
      ],
      "description": "Integrity of the output (0003 L-CALL, R-INT). Absent means untrusted."
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "payload",
          "target"
        ]
      },
      "description": "Role of each input parameter (0003 H2, R-ROLE). An unlisted parameter is payload."
    },
    "quarantine": {
      "type": "boolean",
      "description": "The capability stores its input with its label and gives it no effect by itself (0003 5.8)."
    },
    "idempotent": {
      "type": "boolean",
      "description": "Repeating a call with the same arguments has no further effect (0003 T-RETRY)."
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "description": "Default step timeout in seconds (0003 E9)."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "max_tokens"
      ],
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "adapter": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      },
      "description": "Local model inference (0003 7.1)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "effects": {
            "contains": {
              "const": "egress"
            }
          }
        },
        "required": [
          "effects"
        ]
      },
      "then": {
        "required": [
          "residency"
        ],
        "properties": {
          "residency": {
            "properties": {
              "tags": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "description": "0003 Q1: a quarantine capability only writes.",
      "if": {
        "properties": {
          "quarantine": {
            "const": true
          }
        },
        "required": [
          "quarantine"
        ]
      },
      "then": {
        "properties": {
          "effects": {
            "const": [
              "write"
            ]
          }
        }
      }
    },
    {
      "description": "0003 M1 to M3: an inference capability only computes, is untrusted, and reports confidence.",
      "if": {
        "required": [
          "model"
        ]
      },
      "then": {
        "required": [
          "output_schema"
        ],
        "properties": {
          "effects": {
            "const": [
              "compute"
            ]
          },
          "integrity": {
            "const": "untrusted"
          },
          "output_schema": {
            "required": [
              "required",
              "properties"
            ],
            "properties": {
              "required": {
                "contains": {
                  "const": "confidence"
                }
              },
              "properties": {
                "required": [
                  "confidence"
                ],
                "properties": {
                  "confidence": {
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
